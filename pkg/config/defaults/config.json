{
  "temperature": 0.7,
  "frequency_penalty": 0.2,
  "system_instruction": "You are loop, a minimalist agentic coding harness. Inspect code, edit/write files on disk, and execute commands in the workspace.\nGuidelines:\n1. Actions over Talk: Implement code directly on disk using write/edit tools. Deliver complete working code.\n2. Conciseness: Direct, pragmatic answers. No conversational filler, preambles, or em dashes.\n3. Safety: Read files before editing. Never use bash for file operations.\n4. Arguments Ordering: When calling file tools, always specify 'path' first before 'content'.",
  "auto_approve": false,
  "show_thinking": true,
  "show_tokens": true,
  "theme": "plain",
  "direct_commands": true,
  "skip_verify": false,
  "skills_dir": "~/.loop/skills",
  "max_reasoning_steps": 150,
  "context_window_limit": 128000,
  "auto_adapt_context": false,
  "min_context_window": 32768,
  "compression_threshold": 0.8,
  "reasoning_effort": "low",
  "stream_writes": true,
  "syntax_theme": "monokai",
  "active_provider": "",
  "max_completion_tokens": 12000,
  "compact_prompt": true,
  "tool_protocol": "json",
  "debug_log_file": "off",
  "max_paste_lines": 80,
  "max_paste_chars": 8000,
  "timeout": 1200,
  "max_tool_output_bytes": 8192,
  "repeat_reminder_thresholds": [
    3,
    5
  ],
  "repeat_guard_limit": 10,
  "persistent_bash": true,
  "atomic_writes": true,
  "ask_user_mode": "interactive",
  "approval_always_answer": false,
  "parallel_tool_calls": false,
  "recap_interval": 5,
  "disable_recap": true,
  "presence_penalty": 0.0,
  "collapse_results": false,
  "cert_file": "",
  "key_file": "",
  "ca_file": "",
  "before_tool_hook": "",
  "after_tool_hook": "",
  "disable_local_plugins": false,
  "max_subagent_depth": 0,
  "prompts_file": "",
  "limits": {
    "grep_default_limit": 100,
    "grep_max_limit": 500,
    "grep_max_line_length": 500,
    "grep_max_output_bytes": 65536,
    "grep_max_file_bytes": 2097152,
    "max_windows_per_target": 64,
    "max_tracked_tasks": 256,
    "max_supervised_tasks": 512,
    "task_retention_grace": 60000000000,
    "audit_truncation_chars": 1500,
    "agent_name_max_chars": 64,
    "skill_desc_max_bytes": 2048,
    "skill_content_max_bytes": 131072,
    "max_completion_tokens_floor": 512,
    "max_subagent_depth": 4,
    "repeat_guard_limit": 10,
    "max_output_lines": 2000,
    "max_output_bytes": 51200,
    "max_read_file_bytes": 512000,
    "read_max_line_length": 1000,
    "find_max_results": 500,
    "list_max_entries": 150,
    "list_max_depth": 3,
    "parallel_tool_workers": 4,
    "compaction_reserve_tokens": 16384,
    "mcp_server_workers": 4,
    "mcp_connect_timeout": 2000000000,
    "mcp_request_timeout": 15000000000,
    "escape_disambiguation": 10000000,
    "compaction_keep_recent_tokens": 20000,
    "reasoning_token_budgets": {
      "high": 8192,
      "low": 512,
      "max": -1,
      "medium": 2048
    }
  }
}
